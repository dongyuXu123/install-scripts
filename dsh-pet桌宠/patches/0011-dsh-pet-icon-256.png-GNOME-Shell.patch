 .../{window-icon.png => dsh-pet-icon-256.png}       | Bin
 pet/application_icon.py                             |   4 ++--
 2 files changed, 2 insertions(+), 2 deletions(-)
 rename local-assets/{window-icon.png => dsh-pet-icon-256.png} (100%)

diff --git a/local-assets/window-icon.png b/local-assets/dsh-pet-icon-256.png
similarity index 100%
rename from local-assets/window-icon.png
rename to local-assets/dsh-pet-icon-256.png
diff --git a/pet/application_icon.py b/pet/application_icon.py
index a45a628..2dc417c 100644
--- a/pet/application_icon.py
+++ b/pet/application_icon.py
@@ -41,9 +41,9 @@ __all__ = [
 #: 图标在源码树 / 冻结包里的相对路径（冻结包按 ``sys._MEIPASS`` 为根，与
 #: ``pet/game_fps.py`` 的 ``BACKEND_RELATIVE_DIR`` 同一约定）。三端构建脚本里的
 #: ``--add-data`` 目标必须与它一致。
-#: 本地补丁：源码运行改用 local-assets/window-icon.png（Q 版立绘，比官方
+#: 本地补丁：源码运行改用 local-assets/dsh-pet-icon-256.png（Q 版立绘，比官方
 #: icon.ico 好看）；冻结包候选回退原路径不受影响。
-APPLICATION_ICON_RELATIVE_PATH = ("local-assets", "window-icon.png")
+APPLICATION_ICON_RELATIVE_PATH = ("local-assets", "dsh-pet-icon-256.png")
 
 #: 缓存内容：``(所属应用实例, QIcon)``。用应用实例做键：QIcon 不能早于应用构造，
 #: 也不该跨应用实例复用（测试会重建 QApplication）。
