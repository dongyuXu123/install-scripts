+def _zhipu_quota_text(data) -> str:
+    """把智谱配额响应体解析成人类可读文本（纯函数，便于测试）。
+
+    实测形态（与 cc-switch 一致）：data.limits[].{type,unit,number,percentage,
+    nextResetTime}；unit 3 = 5 小时滚动窗口、6 = 本周窗口（只锚定 unit 不绑
+    number）；data.level 是套餐档位。无可用条目抛 BalanceError。
     """
     if not isinstance(data, dict):
-        return None
-    node = data.get('data') if isinstance(data.get('data'), dict) else data
-    total = ''
-    for key in ('total_balance', 'balance', 'total', 'available_balance'):
-        value = node.get(key)
-        if value not in (None, ''):
-            total = str(value)
-            break
-    if not total:
-        return None
-    granted = str(node.get('granted_balance', '') or '')
-    topped = str(node.get('topped_up_balance', '') or node.get('topped_up', '') or '')
-    return {'is_available': True, 'total': total, 'granted': granted, 'topped_up': topped}
+        raise BalanceError('返回数据无效')
+    if data.get('success') is False:
+        raise BalanceError(str(data.get('msg') or '配额查询失败'))
+    node = data.get('data') if isinstance(data.get('data'), dict) else {}
+    parts = []
+    for item in node.get('limits') or []:
+        if not isinstance(item, dict):
+            continue
+        if str(item.get('type', '')).upper() not in ('TOKENS_LIMIT', 'CREDIT_LIMIT'):
+            continue
+        try:
+            pct = float(item.get('percentage'))
+        except (TypeError, ValueError):
+            continue
+        unit = item.get('unit')
+        if unit == 3:
+            name = '5小时窗口'
+        elif unit == 6:
+            name = '本周窗口'
+        else:
+            name = f'窗口{item.get("number") or ""}'
+        reset = ''
+        ts = item.get('nextResetTime')
+        try:
+            reset = '，' + datetime.fromtimestamp(float(ts) / 1000.0, _BEIJING_TZ).strftime('%m-%d %H:%M') + ' 重置'
+        except (TypeError, ValueError, OSError, OverflowError):
+            pass
+        parts.append(f'{name}已用 {pct:.0f}%{reset}')
+    if not parts:
+        raise BalanceError('响应中没有配额信息：' + json.dumps(data, ensure_ascii=False)[:200])
+    level = str(node.get('level') or '').strip()
+    return (f'[{level}] ' if level else '') + '；'.join(parts)
+
