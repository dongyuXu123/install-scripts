---
 pet/window.py | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/pet/window.py b/pet/window.py
index 17974d2..d5602ad 100644
--- a/pet/window.py
+++ b/pet/window.py
@@ -560,7 +560,11 @@ class PetWindow(QWidget, WindowFeatureGateMixin):
         self.setFocusPolicy(Qt.FocusPolicy.StrongFocus)
         if self._stream_capture_mode:
             self.setWindowTitle(STREAM_CAPTURE_TITLE)
-        self._speech_bubble.set_capture_compat(self._stream_capture_mode, host=self)
+        # 本地补丁：气泡保持独立置顶 Tool 窗口（capture_compat=False）。
+        # 本机实测（XWayland + 半透明主窗）：气泡作为主窗子控件时 visible=True、
+        # 几何正确，但永远不进入窗口渲染缓冲（XGetImage/肉眼均不可见）；独立
+        # Tool 窗口形态经抓帧验证显示正常。代价：OBS 捕获主窗时看不到气泡。
+        self._speech_bubble.set_capture_compat(False)
         # Cocoa hides Tool windows when an accessory application deactivates.
         # Visibility and z-order are separate: always keep the pet visible,
         # then use WindowStaysOnTopHint/NSWindow level for the on-top setting.
