 pet/balance.py | 15 ++++++++++++---
 1 file changed, 12 insertions(+), 3 deletions(-)

diff --git a/pet/balance.py b/pet/balance.py
index 2db9905..e555b5f 100644
--- a/pet/balance.py
+++ b/pet/balance.py
@@ -169,14 +169,23 @@ def _zhipu_quota_parts(data) -> dict:
             main = (remaining, reset)
     if main is None and weekly is None:
         raise BalanceError('响应中没有配额信息：' + json.dumps(data, ensure_ascii=False)[:200])
+    # 顶栏紧凑文本（半角冒号）与卡片完整文本（全角冒号 + 双窗口重置时间）分开出
     text = ''
+    card = ''
     if main is not None:
         text += f'余额 {main[0]:.0f}%'
+        card += f'余额 {main[0]:.0f}%'
     if weekly is not None:
         text += f'（本周余额: {weekly[0]:.0f}%）'
-    card = text
-    if main is not None and main[1] is not None:
-        card += f'，{main[1]:%m-%d %H:%M} 重置'
+        card += f'（本周余额： {weekly[0]:.0f}%）'
+    main_reset = main[1] if main is not None else None
+    weekly_reset = weekly[1] if weekly is not None else None
+    if main_reset is not None:
+        card += f'，{main_reset:%m-%d %H:%M} 重置'
+        if weekly_reset is not None:
+            card += f'（{weekly_reset:%m-%d %H:%M} 本周重置）'
+    elif weekly_reset is not None:
+        card += f'，{weekly_reset:%m-%d %H:%M} 本周重置'
     return {'text': text, 'card_text': card}
 
 
