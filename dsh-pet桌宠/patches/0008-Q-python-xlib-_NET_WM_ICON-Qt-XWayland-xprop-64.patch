diff --git a/pet/application_icon.py b/pet/application_icon.py
index 957ad07..a45a628 100644
--- a/pet/application_icon.py
+++ b/pet/application_icon.py
@@ -41,7 +41,9 @@ __all__ = [
 #: 图标在源码树 / 冻结包里的相对路径（冻结包按 ``sys._MEIPASS`` 为根，与
 #: ``pet/game_fps.py`` 的 ``BACKEND_RELATIVE_DIR`` 同一约定）。三端构建脚本里的
 #: ``--add-data`` 目标必须与它一致。
-APPLICATION_ICON_RELATIVE_PATH = ("assets", "icon.ico")
+#: 本地补丁：源码运行改用 local-assets/window-icon.png（Q 版立绘，比官方
+#: icon.ico 好看）；冻结包候选回退原路径不受影响。
+APPLICATION_ICON_RELATIVE_PATH = ("local-assets", "window-icon.png")
 
 #: 缓存内容：``(所属应用实例, QIcon)``。用应用实例做键：QIcon 不能早于应用构造，
 #: 也不该跨应用实例复用（测试会重建 QApplication）。
diff --git a/pet/window.py b/pet/window.py
index 333fd9d..7f66686 100644
--- a/pet/window.py
+++ b/pet/window.py
@@ -766,6 +766,51 @@ class PetWindow(QWidget, WindowFeatureGateMixin):
         # 已开启的 Agent 联动必须手工展开一次菜单/开关设置对话框才生效（#99）。
         # sync_optional_services() 自身以 _install_effect_services() 收尾。
         self.sync_optional_services()
+        # 本地补丁：窗口/任务栏图标（上游只有设置对话框设置过，主窗口一直顶着
+        # 系统默认通用图标）；Q 版立绘见 local-assets/window-icon.png
+        from .application_icon import load_application_icon
+        self.setWindowIcon(load_application_icon())
+        # 本机 Qt/XWayland 会把 _NET_WM_ICON 写成空属性（最小复现确认，与窗口
+        # 标志无关），任务栏因此拿不到图——显示后用 xprop 直接把 64px ARGB
+        # 数据写回去补一手。
+        QTimer.singleShot(2000, self._apply_net_wm_icon_fallback)
+        QTimer.singleShot(9000, self._apply_net_wm_icon_fallback)
+
+    def _apply_net_wm_icon_fallback(self) -> None:
+        """本地补丁：把窗口图标写成 _NET_WM_ICON。
+
+        本机 Qt/XWayland 下 Qt 自己只会写一个空属性（实测恒空，与窗口标志无关）；
+        xprop -set 命令行又最多收 64 个元素（4098 个的图标数据会被截断成非法值），
+        所以用 python-xlib（纯 Python X11 协议实现，format 32 处理正确）直写完整
+        CARDINAL 数组。依赖：python-xlib（已装入 .venv）。
+        """
+        try:
+            from Xlib import X, Xatom, display as xlib_display
+            from PySide6.QtGui import QImage
+
+            icon = self.windowIcon()
+            if icon.isNull():
+                return
+            img = icon.pixmap(64, 64).toImage().convertToFormat(QImage.Format_ARGB32)
+            width, height = img.width(), img.height()
+            if not width or not height:
+                return
+            data = [width, height]
+            for y in range(height):
+                for x in range(width):
+                    data.append(img.pixel(x, y) & 0xFFFFFFFF)  # ARGB 打包
+            conn = xlib_display.Display()
+            try:
+                window = conn.create_resource_object('window', int(self.winId()))
+                window.change_property(conn.intern_atom('_NET_WM_ICON'),
+                                       Xatom.CARDINAL, 32, data)
+                conn.sync()
+            finally:
+                conn.close()
+        except Exception:  # noqa: BLE001 - 图标是锦上添花，失败不影响本体
+            pass
+        except Exception:  # noqa: BLE001 - 图标是锦上添花，失败不影响本体
+            pass
 
     @property
     def click_sound_enabled(self) -> bool:
