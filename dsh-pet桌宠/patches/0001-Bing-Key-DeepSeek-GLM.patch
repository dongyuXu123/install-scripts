+def _bing_unwrap(href: str) -> str:
+    """还原 Bing 的 bing.com/ck/a 跳转链接：u=a1<base64url> → 原始 URL。"""
+    if 'bing.com/ck/a' not in href:
+        return href
+    m = re.search(r'[?&]u=a1([^&]+)', href)
+    if not m:
+        return href
+    b64 = m.group(1)
+    b64 += '=' * (-len(b64) % 4)
+    try:
+        return base64.urlsafe_b64decode(b64).decode('utf-8', 'replace')
+    except Exception:
+        return href
+
+
+def parse_bing_html(page: str, limit: int) -> list[SearchResult]:
+    results: list[SearchResult] = []
+    for chunk in re.split(r'<li class="b_algo', page)[1:]:
+        m = re.search(r'<h2[^>]*>\s*<a[^>]+href="([^"]+)"[^>]*>(.*?)</a>', chunk, re.S)
+        if not m:
+            continue
+        url = _bing_unwrap(_html.unescape(m.group(1))).strip()
+        title = _clean_text(m.group(2))
+        if not url.startswith('http') or not title:
+            continue
+        s = re.search(r'<p[^>]*>(.*?)</p>', chunk[m.end():], re.S)
+        results.append(SearchResult(title, url, _clean_text(s.group(1))[:400] if s else ''))
+        if len(results) >= limit:
+            break
+    return results
+
