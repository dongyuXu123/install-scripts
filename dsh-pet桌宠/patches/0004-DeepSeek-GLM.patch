+def format_balance_card_labeled(label: str, info: dict) -> str:
+    """展开卡完整行（本地补丁）：DeepSeek 带充值/赠送明细；
+    GLM 带最近重置时间。文本供灵动岛卡片逐行展示。"""
+    quota = str(info.get('quota_card_text', '') or '')
+    if quota:
+        return f'{label}：{quota}'
+    return f'{label}：{format_balance(info)}'
+
